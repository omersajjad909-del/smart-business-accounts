
# ══════════════════════════════════════════════════════════════
#  FINOVA — Environment Variables Template
#  Copy this file to .env and fill in your real values
#  DO NOT commit .env to git — only .env.example
# ══════════════════════════════════════════════════════════════


# 🗄️  DATABASE (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.YOURPROJECT:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20&sslmode=require"
DIRECT_URL="postgresql://postgres.YOURPROJECT:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# 🔐  SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Storage: create a PUBLIC bucket named "product-images" in Supabase → Storage

# 🌐  DOMAIN MAP
# Marketing website
NEXT_PUBLIC_BASE_URL=https://www.finovaos.app
# Main app / login / dashboard
NEXT_PUBLIC_APP_URL=https://usefinova.app
# Optional supporting subdomains
NEXT_PUBLIC_API_URL=https://api.finovaos.app
NEXT_PUBLIC_AI_URL=https://ai.finovaos.app

# Local development override example:
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# 🛡️  ADMIN CONSOLE
# The hostname the admin console is served on. Deliberately NOT admin.<domain>
# and deliberately NOT a NEXT_PUBLIC_ variable — it must never be compiled into
# a client bundle. Point this DNS record at the same deployment. On the public
# app domain, /admin and the admin APIs return an ordinary 404.
# Comma-separate if you need more than one.
ADMIN_HOST=pick-something-unguessable.finovaos.app

# Who may sign into the console from the User table (platform super admins),
# comma separated. REQUIRED in production: with this unset, platform
# super-admin login is refused rather than guessed at.
SUPER_ADMIN_EMAILS=you@example.com

# 🔑  SESSION SECRET (generate: openssl rand -base64 48)
SESSION_SECRET=your_strong_random_secret_min_32_chars
COMPANY_SECRET_MASTER_KEY=your_strong_random_secret_min_32_chars

# 📧  EMAIL — SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=finovaos.app@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="FinovaOS <finovaos.app@gmail.com>"

# 📧  Email Addresses
EMAIL_SUPPORT=finovaos.app@gmail.com
EMAIL_BILLING=finovaos.app@gmail.com
EMAIL_ADMIN=finovaos.app@gmail.com
EMAIL_LEGAL=finovaos.app@gmail.com
EMAIL_MARKETING=finovaos.app@gmail.com
EMAIL_NOREPLY=finovaos.app@gmail.com

# 💳  STRIPE
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
NEXT_PUBLIC_PRICE_STARTER=price_your_starter_price_id
NEXT_PUBLIC_PRICE_STARTER_YEARLY=price_your_starter_yearly_price_id
NEXT_PUBLIC_PRICE_PRO=price_your_pro_price_id
NEXT_PUBLIC_PRICE_PRO_YEARLY=price_your_pro_yearly_price_id
NEXT_PUBLIC_PRICE_ENTERPRISE=price_your_enterprise_price_id
NEXT_PUBLIC_PRICE_ENTERPRISE_YEARLY=price_your_enterprise_yearly_price_id

# 🍋  LEMON SQUEEZY
# Webhook URL (production): https://finovaos.app/api/billing/webhook
# Webhook URL (alternate app domain): https://usefinova.app/api/billing/webhook
# Recommended events:
# - order_created
# - subscription_created
# - subscription_updated
# - subscription_cancelled
# - subscription_resumed
# - subscription_expired
# - subscription_payment_success
# - subscription_payment_failed
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
LEMONSQUEEZY_STORE_ID=your_lemonsqueezy_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_lemonsqueezy_webhook_secret
LEMONSQUEEZY_TEST_MODE=false
LEMONSQUEEZY_VARIANT_STARTER_MONTHLY=your_variant_id
LEMONSQUEEZY_VARIANT_STARTER_YEARLY=your_variant_id
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=your_variant_id
LEMONSQUEEZY_VARIANT_PRO_YEARLY=your_variant_id
LEMONSQUEEZY_VARIANT_ENTERPRISE_MONTHLY=your_variant_id
LEMONSQUEEZY_VARIANT_ENTERPRISE_YEARLY=your_variant_id
LEMONSQUEEZY_VARIANT_CUSTOM_MONTHLY=your_variant_id
LEMONSQUEEZY_VARIANT_CUSTOM_YEARLY=your_variant_id

# 🇵🇰  SAFEPAY (Pakistan — PKR checkout)
# Only used when the buyer's pricing region resolves to PK. If either of the two
# required vars below is missing, hasSafepayConfig() is false and checkout falls
# through to Lemon Squeezy in USD instead.
# Webhook URL: https://finovaos.app/api/billing/webhook
# Set SAFEPAY_ENVIRONMENT=sandbox while testing, "production" once Safepay
# has approved the merchant account and issued live credentials.
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=your_safepay_api_key
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_secret

# 🤖  AI
OPENAI_API_KEY=sk-proj-your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=your_anthropic_claude_api_key

# Cloudflare AI Gateway — optional proxy in front of the AI providers above.
# Set both to route calls through it (caching + cost analytics + fallback);
# leave either blank and every call goes straight to the provider as before.
CF_AI_GATEWAY_ACCOUNT_ID=
CF_AI_GATEWAY_ID=

# 💬  WHATSAPP (Meta Business API)
WHATSAPP_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id

# 📱  SMS
SMS_API_URL=your_sms_provider_api_url
SMS_API_KEY=your_sms_api_key
SMS_FROM=FinovaOS
SMS_API_AUTH_HEADER=Authorization
SMS_API_AUTH_SCHEME=Bearer

# 🔏  GOOGLE OAUTH
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 🏦  PLAID (Bank Integration)
PLAID_ENV=sandbox
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret

# 🔒  ADMIN
ADMIN_SECRET=your_admin_secret_token

# 🔍  SEO
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_code
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id

# 🛠️  DEBUG
DEBUG_PRISMA=false
OTP_DEV_MODE=false

# 🎯  AI PROSPECTING (outbound client acquisition — /admin/prospecting)
# Discovery. Without at least one of these the pipeline runs on placeholder
# companies with .invalid domains, which the sender refuses to mail.
GOOGLE_PLACES_API_KEY=your_google_places_api_key
APOLLO_API_KEY=your_apollo_api_key
# Named decision makers instead of info@ addresses.
HUNTER_API_KEY=your_hunter_api_key
# Deliverability check. Unverified addresses are held back, not sent to.
ZEROBOUNCE_API_KEY=your_zerobounce_api_key
# Who the emails come from, and the postal address the footer must carry.
OUTREACH_SENDER_NAME=Umer Sajjad
OUTREACH_SENDER_TITLE=Founder
OUTREACH_POSTAL_ADDRESS=FinovaOS, Street, City, Pakistan
# Master switch. Leave false until the sending domain is warmed up.
OUTREACH_SENDING_ENABLED=false
# Ceiling across every campaign, and how many one cron run may send.
OUTREACH_GLOBAL_DAILY_CAP=40
OUTREACH_PER_RUN=2
# Sending identity — a SEPARATE domain from the SMTP_* block above, because a
# spam complaint against cold outreach would otherwise take your OTP and
# invoice mail down with it. Resend does not permit cold outreach, so this is
# its own provider: Instantly, Smartlead, or your own Amazon SES.
# lib/prospecting/transport.ts refuses to send until all four are set.
OUTREACH_FROM_EMAIL=Umer <umer@your-outreach-domain.com>
OUTREACH_SMTP_HOST=your_outreach_smtp_host
OUTREACH_SMTP_PORT=587
OUTREACH_SMTP_SECURE=false
OUTREACH_SMTP_USER=your_outreach_smtp_user
OUTREACH_SMTP_PASS=your_outreach_smtp_password
# Leave false. True lets cold outreach go out from finovaos.app itself.
OUTREACH_ALLOW_PRIMARY_DOMAIN=false
